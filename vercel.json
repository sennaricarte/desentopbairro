{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": true,
  "redirects": [
    { "source": "/desentupidora-em-sao-paulo-sp", "destination": "/", "statusCode": 301 },
    { "source": "/desentupidora-em-sao-paulo-sp/", "destination": "/", "statusCode": 301 },
    { "source": "/regioes-atendidas", "destination": "/areas-atendidas/", "statusCode": 301 },
    { "source": "/regioes-atendidas/", "destination": "/areas-atendidas/", "statusCode": 301 },
    { "source": "/cidades-atendidas", "destination": "/areas-atendidas/", "statusCode": 301 },
    { "source": "/cidades-atendidas/", "destination": "/areas-atendidas/", "statusCode": 301 },
    { "source": "/desentupidora-de-alto-impacto-com-atendimento-imediato-em-registro-sp", "destination": "/desentupidora-registro-sp/", "statusCode": 301 },
    { "source": "/desentupidora-de-alto-impacto-com-atendimento-imediato-em-registro-sp/", "destination": "/desentupidora-registro-sp/", "statusCode": 301 },
    { "source": "/desentupidora-registro-urgente", "destination": "/desentupidora-registro-sp/", "statusCode": 301 },
    { "source": "/desentupidora-registro-urgente/", "destination": "/desentupidora-registro-sp/", "statusCode": 301 },
    { "source": "/privacy-policy", "destination": "/politica-de-privacidade/", "statusCode": 301 },
    { "source": "/privacy-policy/", "destination": "/politica-de-privacidade/", "statusCode": 301 },
    { "source": "/hello-world", "destination": "/", "statusCode": 301 },
    { "source": "/hello-world/", "destination": "/", "statusCode": 301 },
    { "source": "/sitemap_index.xml", "destination": "/sitemap-index.xml", "statusCode": 301 },
    { "source": "/wp-sitemap.xml", "destination": "/sitemap-index.xml", "statusCode": 301 },
    { "source": "/page-sitemap.xml", "destination": "/sitemap-index.xml", "statusCode": 301 },
    { "source": "/post-sitemap.xml", "destination": "/sitemap-index.xml", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
