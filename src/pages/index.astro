---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, telLink, waLink } from '../config/site';

const all = (await getCollection('paginas')).filter((p) => !p.data.noindex);
const services = all
  .filter((p) => p.data.kind === 'servico' && ['desentupimento', 'esgotamento', 'hidraulica'].includes(p.data.group))
  .sort((a, b) => a.data.order - b.data.order);
const locals = all.filter((p) => p.data.kind === 'local');

const faq = [
  { q: 'A Desentop Bairro atende 24 horas?', a: 'Sim. O atendimento é 24 horas, todos os dias. Ligue ou chame no WhatsApp e informe o endereço para confirmar a disponibilidade.' },
  { q: 'Quais serviços vocês fazem?', a: 'Desentupimento de pia, ralo, vaso sanitário, colunas e redes de esgoto, limpa fossa, limpeza de caixa de gordura, hidrojateamento, vídeo inspeção e serviços de encanador.' },
  { q: 'Preciso quebrar piso ou parede para desentupir?', a: 'Na maioria dos casos, não. O equipamento adequado desobstrui a tubulação por dentro. A vídeo inspeção ajuda a localizar o problema quando a causa não é clara.' },
  { q: 'Como peço um orçamento?', a: 'Ligue ou chame no WhatsApp, descreva o problema e informe cidade e bairro. Foto ou vídeo ajudam. Peça o orçamento antes de aprovar o serviço.' },
];
const title = 'Desentupidora 24 Horas em São Paulo e Região | Desentop Bairro';
const description = 'Desentupidora 24 horas: pia, ralo, vaso sanitário, esgoto, limpa fossa e hidrojateamento. Atendimento em SP e região. Ligue ou chame no WhatsApp.';
---
<Base title={title} description={description} pageName="Desentupidora 24 Horas em São Paulo e Região" faq={faq}>
  <section class="hero">
    <div class="wrap">
      <span class="badge">{SITE.openingHoursText}</span>
      <h1>Desentupidora 24 horas em São Paulo e região</h1>
      <p class="lead">Entupiu? Desentupimos pia, ralo, vaso sanitário, colunas e redes de esgoto em casas, comércios e condomínios. Fale agora e peça seu orçamento.</p>
      <div class="btns">
        <a class="btn btn-primary" href={telLink}>Ligar {SITE.phoneDisplay}</a>
        <a class="btn btn-wa" href={waLink()} rel="noopener">Chamar no WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Nossos serviços</h2>
      <div class="grid">
        {services.map((s) => (
          <a class="tile" href={`/${s.id}/`}><strong>{s.data.title}</strong><span>{s.data.cardText ?? s.data.description}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <h2>Como funciona o atendimento</h2>
      <ol class="steps">
        <li><strong>Você nos chama</strong><br />Por telefone ou WhatsApp, a qualquer hora.</li>
        <li><strong>Avaliamos o problema</strong><br />Cidade, bairro, tipo de entupimento e fotos ajudam.</li>
        <li><strong>Desobstruímos</strong><br />Equipamento adequado ao tipo de tubulação.</li>
        <li><strong>Orientamos</strong><br />Explicamos a causa e como evitar que volte.</li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Sinais de que você precisa de uma desentupidora</h2>
      <ul>
        <li>Água descendo devagar na pia, no ralo ou no tanque.</li>
        <li>Vaso sanitário subindo ou com descarga fraca.</li>
        <li>Cheiro de esgoto saindo de ralos.</li>
        <li>Esgoto voltando por ralos ou caixas de inspeção.</li>
        <li>Entupimentos que se repetem. Nesse caso, uma <a href="/video-inspecao/">vídeo inspeção</a> mostra a causa.</li>
      </ul>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <h2>Onde atendemos</h2>
      <p>{SITE.areaServedText}. Confirme a disponibilidade para o seu endereço pelo telefone ou WhatsApp. Veja as <a href="/areas-atendidas/">áreas atendidas</a>.</p>
      <div class="grid">
        {locals.map((s) => (
          <a class="tile" href={`/${s.id}/`}><strong>{s.data.title}</strong><span>{s.data.cardText}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap" style="max-width:820px">
      <h2>Perguntas frequentes</h2>
      {faq.map((f) => <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}
      <div class="btns">
        <a class="btn btn-primary" href={telLink}>Ligar {SITE.phoneDisplay}</a>
        <a class="btn btn-wa" href={waLink()} rel="noopener">Chamar no WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
